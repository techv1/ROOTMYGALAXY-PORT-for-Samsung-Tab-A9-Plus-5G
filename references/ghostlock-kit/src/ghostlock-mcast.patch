+void tcp_park_release(void) {
+  atomic_store(&tcp_punch_go, 0);
+  atomic_store(&tcp_punch_stop, 1);
+  if (pre_puncher_started) {
+    pthread_join(pre_puncher, NULL);
+    pre_puncher_started = 0;
+  }
+  if (pre_map != MAP_FAILED) {
+    munmap(pre_map, TCP_PUNCH_SHMEM_LEN);
+    pre_map = MAP_FAILED;
+  }
+  if (pre_punch_fd >= 0) {
+    close(pre_punch_fd);
+    pre_punch_fd = -1;
+  }
+  if (pre_server_fd >= 0) {
+    close(pre_server_fd);
+    pre_server_fd = -1;
+  }
+  if (pre_client_fd >= 0) {
+    close(pre_client_fd);
+    pre_client_fd = -1;
+  }
+}
